{
  "name": "react_template",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./dist",
    "lint": "pnpm lint:eslint && pnpm lint:tsc && pnpm lint:ts && pnpm lint:json",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:tsc": "tsc --project .",
    "lint:ts": "prettier --check --parser typescript 'src/**/*.ts*'",
    "lint:json": "prettier --check '**/*.json'"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "prettier": "^3.5.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.2"
  },
  "browserslist": "> 0.25%, not dead",
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
